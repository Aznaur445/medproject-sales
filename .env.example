# Скопируйте в .env и заполните. Файл .env никогда не коммитится.
# install.sh создаёт .env автоматически и генерирует секреты.

ENV=prod
PUBLIC_URL=https://crm.example.ru
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# --- Домены (A-записи должны указывать на IP сервера) ---
DOMAIN=crm.example.ru
STATUS_DOMAIN=status.example.ru
ACME_EMAIL=you@example.ru

# --- Секреты (генерируются install.sh) ---
SECRET_KEY=
FERNET_KEY=

# --- PostgreSQL ---
# Вариант 1 (по умолчанию): база в Docker на этом же сервере.
COMPOSE_PROFILES=localdb
# Вариант 2: управляемая база Timeweb Cloud. Очистите COMPOSE_PROFILES= и укажите адрес:
# DATABASE_URL=postgresql+psycopg://пользователь:пароль@хост:5432/medproject?sslmode=require
# Отдельная схема в общей базе (нужна для управляемой базы PostgreSQL 15+). Пусто = public.
DB_SCHEMA=
POSTGRES_USER=medproject
POSTGRES_PASSWORD=
POSTGRES_DB=medproject

# Одноразовая ссылка первого входа https://ДОМЕН/setup?token=... (если пользователей ещё нет).
SETUP_TOKEN=

# --- Telegram (можно оставить пустым и задать в панели: Настройки → Подключения) ---
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID (узнать: написать боту @userinfobot). Несколько через запятую.
TELEGRAM_OWNER_IDS=

# --- Почта Mail.ru / VK WorkSpace (пароль приложения; можно задать в панели) ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SSL=true
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=МедПроект

# --- ИИ: deepseek | yandexgpt | none ---
LLM_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- S3 Timeweb Cloud (копии бэкапов) ---
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=14
